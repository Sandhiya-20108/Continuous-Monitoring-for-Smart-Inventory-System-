# Server Configuration
PORT=5000
FLASK_DEBUG=True
FLASK_ENV=development
SECRET_KEY=smart-inventory-risk-secret-key-2026

# MongoDB Atlas Configuration
# Replace with your actual connection string from MongoDB Atlas
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=
MONGODB_DATABASE=smart_inventory
MONGODB_COLLECTION=products
MONGODB_USERS_COLLECTION=users
MONGODB_TIMEOUT_MS=3000
MONGODB_TLS_ALLOW_INVALID=false
